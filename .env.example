# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=
# Public anon key (safe to ship). NEVER put the service_role key here.
VITE_SUPABASE_ANON_KEY=
# true = run entirely from localStorage (demo insurance). Auto-on when the two values above are empty.
VITE_DEMO_MODE=false
# Cloudflare Turnstile site key (public). Leave empty to hide the login CAPTCHA.
VITE_TURNSTILE_SITE_KEY=
